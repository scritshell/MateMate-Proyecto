<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvMoveSan"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        tools:text="e4" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:background="@color/explorer_bar_track">

        <View android:id="@+id/viewWhiteBar"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@color/explorer_bar_white"/>

        <View android:id="@+id/viewDrawBar"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@color/explorer_bar_draw"/>

        <View android:id="@+id/viewBlackBar"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@color/explorer_bar_black"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTotalGames"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        tools:text="1200"/>
</LinearLayout>
